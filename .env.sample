# Copy to .env and set your own secrets (openssl rand -hex 16)
TOKEN=eef65e8151d1cc5b5d772c3607deff2a
PORT=8080

# Web login credentials (session cookie lasts 30 days)
LOGIN_USER=admin
LOGIN_PASS=change-me

# Optional: dedicated secret for signing session cookies.
# Defaults to sha256(TOKEN), or sha256(LOGIN_USER:LOGIN_PASS) if TOKEN is unset.
# SESSION_SECRET=

# Initial working directory for new shells (defaults to the user's home dir)
WORKDIR=/home/raja
