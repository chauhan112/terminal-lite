[Unit]
Description=Web terminal (xterm.js + PTY over WebSocket)
After=network.target

[Service]
User=raja
Group=raja
EnvironmentFile=/home/raja/timeline/2026/AITesting/timeline/2026/q4/agents/terminal/.env
ExecStart=/home/raja/timeline/2026/AITesting/timeline/2026/q4/agents/terminal/terminal -addr 127.0.0.1:${PORT} -token ${TOKEN}
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
